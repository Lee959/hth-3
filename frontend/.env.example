VITE_API_BASE_URL=http://localhost:5000/api

# Auth0 SPA app (see docs/SETUP.md). Left empty, the app skips log in and the
# backend's dev mode (DEV_USER_SUB) answers as the demo user. Real values
# look like:
#   VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
#   VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
#   VITE_AUTH0_AUDIENCE=https://api.yourapp.com
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

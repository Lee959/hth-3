FLASK_ENV=development
SECRET_KEY=change-me

# Postgres connection string. Point this at a local docker-compose Timescale
# instance for dev, or a Tiger Cloud service string for the demo/prod deploy.
DATABASE_URL=postgresql://hth3:hth3dev@localhost:5432/hth3_dev

# Auth0 (API / backend side) - see docs/SETUP.md
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.yourapp.com
AUTH0_ALGORITHMS=RS256

# Presage Physiology API - see docs/SETUP.md and docs/ARCHITECTURE.md
PRESAGE_API_KEY=your-presage-api-key
PRESAGE_API_BASE=https://api.physiology.presagetech.com

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

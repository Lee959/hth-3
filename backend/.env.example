FLASK_ENV=development
SECRET_KEY=change-me

# Postgres connection string. Point this at a local docker-compose Timescale
# instance for dev, or a Tiger Cloud service string for the demo/prod deploy.
DATABASE_URL=postgresql://hth3:hth3dev@localhost:5432/hth3_dev

# Auth0 (API / backend side) - see docs/SETUP.md. Left empty, the API runs in
# dev mode as DEV_USER_SUB below. Real values look like:
#   AUTH0_DOMAIN=your-tenant.us.auth0.com
#   AUTH0_AUDIENCE=https://api.yourapp.com
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ALGORITHMS=RS256

# Local dev without Auth0: while AUTH0_DOMAIN/AUTH0_AUDIENCE are unset, every
# request acts as this user (`flask --app run seed-demo-user` creates it).
# Leave empty anywhere shared or deployed.
DEV_USER_SUB="demo|example-user"

# Presage Physiology API - see docs/SETUP.md and docs/ARCHITECTURE.md
# Left empty, heart-rate uploads return 503 instead of calling Presage.
PRESAGE_API_KEY=
PRESAGE_API_BASE=https://api.physiology.presagetech.com

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
